{
  "schemaVersion": 1,
  "contentVersion": "2026-10-21-intermediate",
  "title": "Software Learnings",
  "tracks": [
    {
      "id": "spring",
      "title": "Java · Spring Boot",
      "description": "Follow one request from startup to SQL, then test failures. Java knowledge is enough to start.",
      "version": "Java 21 · Spring Boot 4.0.3 teaching baseline",
      "hours": 36
    },
    {
      "id": "ruby",
      "title": "Ruby · Rails at work",
      "description": "Understand Ruby first. Then trace requests, queries, transactions, and jobs in a legacy Rails stack.",
      "version": "Ruby 2.7.8 · Rails 4.2.11.3 · Sidekiq 5.2",
      "hours": 48
    },
    {
      "id": "git",
      "title": "Git · Change with confidence",
      "description": "See what each command changes. Practice recovery in a disposable repository.",
      "version": "Modern Git; check git --version for command availability",
      "hours": 20
    },
    {
      "id": "frontend",
      "title": "Frontend · JavaScript & Vue 3",
      "description": "Build JavaScript and CSS foundations. Follow Vue 3 state, requests, forms, rendering, and tests. React and Next.js remain comparison chapters.",
      "version": "JavaScript and TypeScript · CSS · Vue 3.5 · Vue 2 compatibility notes",
      "hours": 62
    },
    {
      "id": "ux",
      "title": "UX · Design for understanding",
      "description": "Reason from tasks, perception, access, and evidence. Improve a support workflow one decision at a time.",
      "version": "Web UX · WCAG 2.2 · principles, not magic formulas",
      "hours": 18
    },
    {
      "id": "cloud",
      "title": "AWS · Run a Rails application",
      "description": "Follow a request, file, job, and secret through AWS. Set up small examples and understand their cost and failure paths.",
      "version": "AWS SDK for Ruby v3 · service-specific setup · no cloud resources created automatically",
      "hours": 40
    },
    {
      "id": "ops",
      "title": "Production toolkit · Build and operate",
      "description": "Docker, Kubernetes, Redis, observability, delivery, and useful integrations. Learn what each tool adds and what you must still own.",
      "version": "Pinned local examples · version-labelled configuration fragments",
      "hours": 44
    },
    {
      "id": "events",
      "title": "Event-driven systems · Kafka & Rails",
      "description": "Build a mental model of the log, then follow an outbox event through a real multi-file Rails/Kafka lab.",
      "version": "Kafka 4.1 KRaft · lab Ruby 3.3 / Rails 7.2 · legacy Rails adaptation notes",
      "hours": 24
    }
  ],
